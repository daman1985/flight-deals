# Browser-safe public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Next.js server-only configuration
SUPABASE_SECRET_KEY=sb_secret_placeholder
FARE_WORKER_URL=http://127.0.0.1:8000
FARE_WORKER_SHARED_SECRET=replace_with_a_random_secret

# Airfare worker/provider configuration
# Optional. fli supplies a default Google consent cookie when this is unset.
FLI_SOCS_COOKIE=
# Optional path for TLS-intercepting environments.
FLI_CA_BUNDLE=

# Development-only controlled acquisition proof
TEST_USER_ID=00000000-0000-0000-0000-000000000000
TEST_WATCH_ID=00000000-0000-0000-0000-000000000000
TEST_DEPARTURE_DATE=2026-11-12
TEST_RETURN_DATE=2026-11-16

# Scheduled-job authentication
CRON_SECRET=replace_with_a_random_secret
